# ==== Server ====
PORT=5000
NODE_ENV=development

# ==== Supabase ====
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE=eyJhbGciOi...  (the "service_role" secret - keep private!)

# ==== Security ====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ==== Bootstrap (optional) ====
# Comma-separated emails that become Grievance Officer on first signup.
ADMIN_EMAILS=
OFFICER_EMAILS=

# ==== Client ====
# In production set to your Vercel URL, e.g. https://grievance-xyz.vercel.app
CLIENT_ORIGIN=http://localhost:5500

# ==== Uploads ====
MAX_UPLOAD_MB=5
